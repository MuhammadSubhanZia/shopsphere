# Copy this file to .env and adjust the values. Never commit the real .env file.

# Port the API listens on
PORT=5000

# MongoDB connection string.
# Local MongoDB:  mongodb://127.0.0.1:27017/shopsphere
# MongoDB Atlas:  mongodb+srv://shopsphere:shopsphere1234@cluster0.euneozs.mongodb.net/
MONGODB_URI=mongodb://127.0.0.1:27017/shopsphere

# Address of the React app (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Long random text used to sign the session cookie. Change it!
SESSION_SECRET=change-me-to-a-long-random-string
